# Copy this file to .env and fill in real values. NEVER commit the real .env file.
# Used by `docker-compose up -d` (docker-compose.yml reads these via ${VAR:-default}).

# --- HuggingFace (optional, only needed for gated/private models) ---
HUGGINGFACE_TOKEN=

# --- API key authentication (Auth:ApiKeys) ---
# Do NOT put the plaintext key here. Compute its SHA-256 hex hash first — see
# tools/hash-key in the README — and put the HASH here.
API_KEY_HASH=
API_KEY_NAME=local-dev
# API_KEY_TENANT_ID=

# --- Optional remote validation (Auth:RemoteValidation) ---
# Delegates key validation to the organization service instead of (or in addition to)
# the static key above. Leave disabled unless the org service endpoint is available.
AUTH_REMOTE_VALIDATION_ENABLED=false
AUTH_REMOTE_VALIDATION_ENDPOINT=

# --- Rate limiting (RateLimiting) ---
RATE_LIMIT_PERMIT_PER_MINUTE=120
RATE_LIMIT_BATCH_PERMIT_PER_MINUTE=30
